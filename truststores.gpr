with "config/truststores_config.gpr";
with "../cryptolib/cryptolib.gpr";
with "../hostkit/hostkit.gpr";
project Truststores is
   for Library_Name use "truststores";
   for Library_Version use Project'Library_Name & ".so.0.1.0";
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & external ("ALIRE_BUILD_PROFILE", "development");
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("TRUSTSTORES_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM100", "-gnatwa");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;
end Truststores;
