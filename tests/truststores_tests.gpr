with "config/truststores_tests_config.gpr";
with "../truststores.gpr";
project Truststores_Tests is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/" & external ("ALIRE_BUILD_PROFILE", "development");
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("truststores_tests.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM100", "-gnatwa");
   end Compiler;

   --  Bytes out as bytes in; see the note in devcert.gpr.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;
end Truststores_Tests;
