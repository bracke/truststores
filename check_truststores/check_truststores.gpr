with "config/check_truststores_config.gpr";
project Check_Truststores is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Check_Truststores_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("check_truststores.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Check_Truststores_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM100", "-gnata");
   end Compiler;

   --  Bytes out as bytes in; see the note in truststores.gpr.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;

end Check_Truststores;
